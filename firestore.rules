rules_version = '2';

/**
 * Recommended Firestore Security Rules for Premium Store.
 *
 * This file is NOT auto-deployed - paste it into Firebase Console ->
 * Firestore Database -> Rules -> Publish (or `firebase deploy --only
 * firestore:rules` if you have firebase-tools set up; there's no
 * firebase.json in this repo yet).
 *
 * IMPORTANT - two known gaps these rules deliberately do NOT close,
 * because closing them properly needs server-side infrastructure this
 * project doesn't have yet (no Cloud Functions, no Firebase Admin SDK on
 * the PHP side). Flagged in chat as findings, not silently patched here:
 *
 *  1. `users/{uid}.balance` stays writable by its own owner, because
 *     deposit.php and redeem.php currently credit balance directly from
 *     the client after a payment/voucher check. A user could still set
 *     their own balance to any value via the browser console. Closing
 *     this for real requires balance credits to happen through a
 *     privileged server identity (Cloud Function or Admin-SDK-backed PHP
 *     endpoint) instead of the client.
 *  2. `stock_items.content` (the actual delivered account credentials)
 *     is reachable by any signed-in buyer's Firestore query today,
 *     because toko.php reads a stock item directly client-side to
 *     complete a purchase. There is no per-field redaction in Firestore
 *     rules, so anyone signed in can currently query unsold stock and
 *     read the credentials of accounts they haven't bought. This is the
 *     same underlying gap as #1 (no privileged fulfillment path) and is
 *     the most severe finding of this pass - fixing it means moving
 *     purchase fulfillment behind a Cloud Function/Admin-SDK endpoint
 *     that never exposes the stock_items collection to clients directly.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- users ----
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'buyer'
        && request.resource.data.balance == 0
        && (
          request.resource.data.is_reseller == false ||
          (
            request.resource.data.reseller_token != null &&
            get(/databases/$(database)/documents/reseller_tokens/$(request.resource.data.reseller_token)).data.is_active == true
          )
        );
      // Owner can update their own profile fields (name/phone/username/balance -
      // see gap #1 above) but can never change role, is_reseller, or uid
      // themselves. Only an admin can.
      allow update: if isAdmin() || (
        isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.is_reseller == resource.data.is_reseller &&
        request.resource.data.uid == resource.data.uid
      );
      allow delete: if isAdmin();
    }

    // Minimal public lookup so register.php's unauthenticated
    // username-uniqueness check never has to query the full users
    // collection (which would otherwise leak every user's data to an
    // unauthenticated visitor).
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    match /reseller_tokens/{token} {
      allow get: if true;   // needed pre-signup, before the user is authenticated
      allow list: if false;
      allow write: if isAdmin();
    }

    // ---- catalog (public browsing) ----
    match /products/{id}/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // See gap #2 above - kept to signed-in users (not fully public) as a
    // floor, but this does not stop a signed-in buyer from reading
    // unsold accounts' `content` today.
    match /stock_items/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vouchers/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- user-owned records (all keyed by a user_id field) ----
    match /orders/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /warranties/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow write: if isAdmin();
    }

    match /claims/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /deposits/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid); // see gap #1
      allow delete: if false;
    }

    match /balance_history/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false; // append-only ledger
    }

    // Deterministic doc ID ({voucherCode}_{uid}, see redeem.php) turns the
    // double-redeem check into an atomic rule instead of a racy client
    // read-then-write.
    match /voucher_uses/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && id == (request.resource.data.voucher_code + '_' + request.auth.uid);
      allow update, delete: if false;
    }

    // ---- live chat ----
    match /chats/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'ai'
        && request.resource.data.assigned_admin_id == null;
      // Owner may only escalate ai -> waiting_admin themselves; claiming
      // (-> active_admin), reassigning, or closing is admin-only.
      allow update: if isAdmin() || (
        isSignedIn() && resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.assigned_admin_id == resource.data.assigned_admin_id &&
        (request.resource.data.status == resource.data.status ||
          (resource.data.status == 'ai' && request.resource.data.status == 'waiting_admin'))
      );
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isAdmin() || (isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.user_id == request.auth.uid);
        allow create: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.user_id == request.auth.uid &&
          request.resource.data.sender_type in ['user', 'ai'] &&
          (request.resource.data.sender_type != 'user' || request.resource.data.sender_id == request.auth.uid)
        );
        // Either side may only toggle their own read-receipt fields.
        allow update: if isAdmin() || (
          isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.user_id == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read_by_user', 'read_by_user_at'])
        );
        allow delete: if false;
      }
    }

    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }
  }
}
