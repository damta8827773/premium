Options -Indexes
Options -MultiViews

# Security headers (OWASP A05: Security Misconfiguration).
# CSP allows 'unsafe-inline' for script/style because this app's pages use
# inline <script> blocks throughout rather than external files or nonces -
# rewriting that is a much larger change than a header addition. Even so,
# this still meaningfully restricts: object-src (no Flash/plugins),
# base-uri (no <base> tag injection), frame-ancestors (clickjacking, same
# effect as X-Frame-Options but CSP-enforced), form-action (forms can't
# submit to an attacker's domain), and connect-src/script-src/frame-src to
# only the hosts this app actually talks to (Firebase, Google Sign-In,
# Midtrans, Google Fonts) - an injected <script src="evil.com"> or a fetch()
# to an attacker's exfil endpoint is still blocked by those.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://www.gstatic.com https://app.midtrans.com https://app.sandbox.midtrans.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://*.firebaseapp.com https://firebasestorage.googleapis.com https://api.midtrans.com https://app.midtrans.com https://app.sandbox.midtrans.com https://api.anthropic.com; frame-src https://app.midtrans.com https://app.sandbox.midtrans.com https://accounts.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# PHP settings
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 60

# Serve .php files without extension (optional clean URLs)
RewriteEngine On
RewriteBase /

# Preserve the Authorization header for API auth - mod_php/CGI setups often
# strip it before PHP ever sees it, unlike the built-in PHP server.
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Obfuscated page URLs use /name/hexsuffix instead of the actual
# name-hexsuffix.php filename on disk, so the random suffix reads as a
# path segment rather than being visibly glued to a filename. Admin rule
# must come first since it's the more specific of the two patterns.
RewriteCond %{DOCUMENT_ROOT}/admin/$1-$2.php -f
RewriteRule ^admin/([a-z][a-z-]*)/([0-9a-f]{12})/?$ admin/$1-$2.php [L,QSA]

RewriteCond %{DOCUMENT_ROOT}/$1-$2.php -f
RewriteRule ^([a-z][a-z-]*)/([0-9a-f]{12})/?$ $1-$2.php [L,QSA]

# Redirect /page to /page.php (only if the .php file exists and the path isn't a real file/dir)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# Security: block direct access to sensitive directories and files
RewriteRule ^backend/config/ - [F,L]
RewriteRule ^backend/includes/security-monitor\.php$ - [F,L]
RewriteRule ^backend/security-logs/ - [F,L]
RewriteRule ^temp/   - [F,L]
RewriteRule ^\.      - [F,L]

# Block access to PHP files inside api/ except legitimate endpoints
# (scoped to backend/api/ only - a bare <FilesMatch> here would match every
# .php file on the whole site, not just this directory)
RewriteCond %{REQUEST_URI} ^/backend/api/
RewriteCond %{REQUEST_URI} !^/backend/api/(midtrans-create|midtrans-notify|check-payment|ai-chat-reply|checkout|redeem-voucher|analyze-deposit-proof|apply-referral)\.php$
RewriteRule ^backend/api/.*\.php$ - [F,L]

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg  "access plus 1 month"
  ExpiresByType image/png   "access plus 1 month"
  ExpiresByType image/gif   "access plus 1 month"
  ExpiresByType image/webp  "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css    "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json
</IfModule>

# Protect uploads directory - allow image viewing but block PHP execution
<IfModule mod_rewrite.c>
  RewriteRule ^uploads/.*\.php$ - [F,L]
</IfModule>
